# Cross-linked packages supported by install.sh --package
# Format: package-name path-from-skills.manifest
#
# Independent skills are intentionally absent: install either every skill or a
# complete cross-linked package. This avoids partial dependency installs.

project-management skills/project-management/project-bootstrap
project-management skills/project-management/status-ledger
project-management skills/project-management/project-audit
project-management skills/project-management/ingest

interview skills/interview
interview skills/interview/reverse-brief
